---
// The home page. It is a Starlight page with the splash template, so it
// shares the docs' header, search (`/`), skip link and footer. The hero is
// Starlight's, restyled below; everything after it is this page's own.
//
// The page is one sky, from day to night. The ground changes three times,
// each time at an edge of terminal cells rather than a straight line:
// Pale Methyl Blue day behind the title, Naples Yellow dusk rising behind
// the pitch and running through the key tour, the brown night of the
// ground color under the services and the diagram, and near-black cloud
// tops rising behind the closing into the footer. The cells come from
// src/lib/sky-cells.mjs. Text takes the ink of the ground it can sit on:
// dark ink on blue and yellow, off-white on brown and near-black.
//
// Every docs link goes through docHref(), which fails the build when the
// page or anchor it names does not exist.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import InstallCommand from '../components/landing/InstallCommand.astro';
import DemoRecording from '../components/landing/DemoRecording.astro';
import KeyTour from '../components/landing/KeyTour.astro';
import ServicePlate from '../components/landing/ServicePlate.astro';
import HowItWorks from '../components/landing/HowItWorks.astro';
import CellCloud from '../components/landing/CellCloud.astro';
import Wordmark from '../components/landing/Wordmark.astro';
import { docHref } from '../lib/doc-links.mjs';
import { REPO_BLOB_URL, buildSidebar, firstPageUrl } from '../lib/docs-source.mjs';
import { countDetailServices, readServices } from '../lib/services-index.mjs';
import { COLORS, cloudSvg, cssUrl, edgeSvg, fringeSvg, moonSvg, skyline, starSvg } from '../lib/sky-cells.mjs';

const INSTALL = 'brew install filipeaaoliveira/tap/nuvem';
const pageTitle = 'nuvem: a terminal UI for Google Cloud';
const description =
	'nuvem is a terminal UI for Google Cloud, like k9s is for Kubernetes. Browse and operate your projects from the keyboard, with the gcloud configurations you already have.';

const docs = {
	install: await docHref('getting-started/install.md'),
	cargo: await docHref('getting-started/install.md#install-with-cargo'),
	release: await docHref('getting-started/install.md#download-a-release'),
	source: await docHref('getting-started/install.md#build-from-source'),
	firstRun: await docHref('getting-started/first-run.md'),
	demo: await docHref('guides/demo-mode.md'),
	credentials: await docHref('troubleshooting/faq.md#does-nuvem-store-my-credentials'),
	beforeChange: await docHref('reference/services/overview.md#before-a-change-runs'),
	keys: await docHref('reference/keys.md'),
	start: firstPageUrl(buildSidebar()),
};

const serviceCount = readServices().length;
const COUNT_WORDS = ['Zero', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten', 'Eleven', 'Twelve', 'Thirteen', 'Fourteen', 'Fifteen', 'Sixteen', 'Seventeen', 'Eighteen', 'Nineteen', 'Twenty'];
const serviceWord = COUNT_WORDS[serviceCount] ?? String(serviceCount);
const detailCount = countDetailServices();
const detailWord = (COUNT_WORDS[detailCount] ?? String(detailCount)).toLowerCase();

/** The key tour: each stop is a captured screen and the key that reaches it. */
const stops = [
	{
		id: 'home',
		keys: ['h'],
		shortcut: 'h',
		label: 'Home',
		frame: 'frame-home',
		focus: 'Inventory',
		description: "nuvem's Home view: the active configuration, account, region and project, then a count of loaded resources for each service.",
		caption: 'Home shows the active gcloud configuration and how many resources each service holds.',
		link: { text: 'Home', href: 'guides/home-overview.md' },
	},
	{
		id: 'services',
		keys: ['g'],
		shortcut: 'g',
		label: 'Services',
		frame: 'frame-resources',
		focus: 'Service navigator',
		description: 'The Resources view: a sidebar of services grouped by kind, a list of ten GCE instances, and a preview of the selected one.',
		captionKey: 'g',
		caption: `opens Resources: ${serviceWord.toLowerCase()} services in a sidebar, grouped by kind, each a list you can sort.`,
		link: { text: 'Services', href: 'reference/services/overview.md' },
	},
	{
		id: 'filter',
		keys: ['/', 'Enter'],
		shortcut: '/',
		label: 'Filter, open',
		frame: 'frame-detail',
		focus: 'GCE instance detail',
		description: 'A GCE instance list filtered by the regex "web" to two of ten rows, with the detail of web-frontend-1 open beside it.',
		caption: 'Filter by regex, fuzzy match, label or inverse match, then open a row with Enter.',
		link: { text: 'Filter a list', href: 'guides/filter-a-list.md' },
	},
	{
		id: 'palette',
		keys: [':'],
		shortcut: ':',
		label: 'Command palette',
		frame: 'frame-palette',
		focus: 'commands',
		description: "nuvem's command palette open over a resource list, offering the commands for the selected row and the views it can open.",
		caption: 'Run a command by name instead of remembering its key.',
		link: { text: 'Command palette', href: 'guides/command-palette.md' },
	},
	{
		id: 'lifecycle',
		keys: ['Space', ':'],
		shortcut: 'Space :',
		label: 'Lifecycle',
		frame: 'frame-confirm',
		focus: 'confirm GCE action',
		description: 'A confirmation to stop the instance web-frontend-1, showing its zone, configuration, project, impact and the call compute.instances.stop.',
		caption: 'Mark rows with Space to act on several at once. The confirmation shows the API call first.',
		link: { text: 'Lifecycle actions', href: 'guides/batch-actions.md' },
	},
	{
		id: 'bigquery',
		keys: ['Enter'],
		label: 'BigQuery',
		frame: 'frame-bigquery',
		focus: 'Preview',
		description: 'The tables of the BigQuery dataset analytics, with their type, creation time, rows and size, and a preview of daily_active_users.',
		captionKey: 'Enter',
		caption: 'on a BigQuery dataset lists its tables, with the selected one in a preview.',
		link: { text: 'BigQuery datasets', href: 'reference/services/bigquery-datasets.md' },
	},
	{
		id: 'help',
		keys: ['?'],
		shortcut: '?',
		label: 'Help',
		frame: 'frame-help',
		focus: 'help',
		description: 'The help overlay for the Resources view, listing its keys and the global ones.',
		captionKey: '?',
		caption: 'lists the keys for the view you are in. Every key is on the',
		link: { text: 'Keys page', href: 'reference/keys.md' },
	},
];
for (const stop of stops) stop.link.href = await docHref(stop.link.href);

/** The rest of what someone deciding whether to install should know. */
const more = [
	{
		reach: [{ key: 'l' }],
		name: 'Cloud Logging',
		href: 'guides/cloud-logging.md',
		text: "Read, tail and search the project's logs. In most services, L opens the logs of the selected resource.",
	},
	{
		reach: [{ key: 't' }],
		name: 'Tunnels',
		href: 'guides/tunnels.md',
		text: 'Start IAP, SSH or Cloud SQL Auth Proxy port forwards from a GCE instance or Cloud SQL row, and manage them from one list.',
	},
	{
		reach: [{ flag: '--read-only' }],
		name: 'Read-only mode',
		href: 'guides/read-only-mode.md',
		text: 'Refuses every change to a cloud resource, and the SSH and k9s sessions that can make one.',
	},
	{
		reach: [{ key: ',' }],
		name: 'Plugins',
		href: 'plugins/overview.md',
		text: 'Add your own gcloud commands to a service. They run against the selected row, after a confirmation that shows the whole command line.',
	},
];
for (const item of more) item.href = await docHref(item.href);

/** Spoken before the key column, so a screen reader hears "Key: l", not "l". */
const reachLabel = (reach) => (reach[0].flag ? 'Flag:' : 'Key:');

/*
 * The sky. Edges are drawn on 12-pixel cells, 160 cells wide (1920 pixels),
 * and repeat sideways; phones show the same drawing at 6-pixel cells.
 */
const EDGE_CELL = 12;
// Each edge is only as tall as the clear space kept for it, so no edge can
// cross a line of text: the dusk rises at most 36px above the recording,
// into a 48px gap under the hero's text; the close rises into padding kept
// below the closing's text.
const dusk = skyline({ w: 160, h: 7, seed: 4, r: [2, 4.4], solid: 3 });
const nightfall = skyline({ w: 160, h: 8, seed: 9, r: [2, 4.5] });
const closing = skyline({ w: 160, h: 8, seed: 17, r: [2, 4.6] });
const sky = {
	'--sky-dusk': cssUrl(edgeSvg(dusk, EDGE_CELL, COLORS.naples)),
	'--sky-dusk-h': `${dusk.length * EDGE_CELL}px`,
	'--sky-fall': cssUrl(fringeSvg(nightfall, EDGE_CELL, COLORS.naples)),
	'--sky-fall-h': `${(nightfall.length + 2) * EDGE_CELL}px`,
	'--sky-close': cssUrl(edgeSvg(closing, EDGE_CELL, COLORS.ink)),
	'--sky-close-h': `${closing.length * EDGE_CELL}px`,
	// Day clouds beside the title: a large one cropped by the page edge, a small one.
	'--sky-day-large': cssUrl(cloudSvg('large', 6, COLORS.text, COLORS.coral)),
	'--sky-day-small': cssUrl(cloudSvg('small', 4, COLORS.text, COLORS.coral)),
};
const skyStyle = Object.entries(sky)
	.map(([k, v]) => `${k}: ${v}`)
	.join('; ');

/** Night decorations: a cell moon and stars, placed by fraction of their row. */
const moon = moonSvg(6, COLORS.naples);
const plus = starSvg('plus', 4, COLORS.text);
const dot = (color) => starSvg('dot', 4, color);
---

<StarlightPage
	frontmatter={{
		title: 'nuvem',
		description,
		template: 'splash',
		pagefind: false,
		prev: false,
		next: false,
		hero: {
			title: 'A terminal UI for Google&nbsp;Cloud',
		},
		head: [
			{ tag: 'title', content: pageTitle },
			{ tag: 'meta', attrs: { property: 'og:title', content: pageTitle } },
			{ tag: 'meta', attrs: { property: 'og:type', content: 'website' } },
			{ tag: 'meta', attrs: { name: 'theme-color', content: '#54afb4' } },
			{ tag: 'meta', attrs: { name: 'color-scheme', content: 'dark' } },
		],
	}}
>
	<Fragment set:html={`<style>:root { ${skyStyle} }</style>`} />
	<div class="nv-landing not-content">
		<div class="get-it">
			<p class="pitch">Browse and operate your Google Cloud projects from the keyboard, in the spirit of k9s. nuvem works with the gcloud configurations you already have, and shows you what it is about to do before it changes anything.</p>
			<div class="install-stack">
				<InstallCommand id="install-top" command={INSTALL} />
				<p class="also">Homebrew on macOS and Linux. Or install with <a href={docs.cargo}>cargo</a>, download a <a href={docs.release}>release binary</a>, or <a href={docs.source}>build from source</a>.</p>
				<p class="next">Try it first with <code>nuvem --demo</code>, on sample data with no account. Your own projects need the gcloud CLI, signed in. See <a href={docs.firstRun}>First run</a>.</p>
			</div>
		</div>

		<div class="dusk">
			<div class="sky-edge dusk-edge" aria-hidden="true"></div>
			<DemoRecording
				description="A tour of nuvem --demo on its built-in sample data: Home, a resource list, a filter, a detail view, a Stop confirmation, BigQuery tables and help."
			/>

			<section class="tour-section" aria-labelledby="tour">
				<div class="tour-head">
					<div class="title-row">
						<h2 id="tour" class="title">Press a key</h2>
						<CellCloud class="title-cloud" shape="small" body={COLORS.coral} shade={COLORS.eugenia} cell={4} />
					</div>
					<p class="intro">Real screens from <code>nuvem --demo</code>, set as text. Click a key, or move to the keys with Tab and type one.</p>
					<div class="deco-column" aria-hidden="true">
						<CellCloud class="dusk-cloud" shape="large" body={COLORS.coral} shade={COLORS.eugenia} cell={8} />
						<CellCloud class="dusk-cloud-small" shape="small" body={COLORS.coral} shade={COLORS.eugenia} cell={6} />
					</div>
				</div>
				{/* The recording's poster is Home, so the tour opens on the next screen. */}
				<KeyTour stops={stops} initial="services" />

				{/* Set as nuvem sets its own help overlay: a framed list of keys. */}
				<section class="help" aria-labelledby="more-title">
					<h3 class="help-title" id="more-title">Also in nuvem</h3>
					<dl class="help-keys">
						{
							more.map((item) => (
								<div class="help-row">
									<dt>
										<span class="sr-only">{reachLabel(item.reach)} </span>
										{item.reach.map((r) => (r.key ? <kbd>{r.key}</kbd> : <code>{r.flag}</code>))}
										<a href={item.href}>{item.name}</a>
									</dt>
									<dd>{item.text}</dd>
								</div>
							))
						}
					</dl>
				</section>
				<p class="rest">Configurations, FinOps, related-resource jumps and themes are in the <a href={docs.start}>documentation</a>, and the <a href={docs.keys}>Keys</a> page lists every key.</p>
			</section>
		</div>

		<div class="night">
			<div class="sky-edge fall-edge" aria-hidden="true"></div>
			{/* A row kept free of text for the first stars of the night. */}
			<div class="deco-row stars-row" aria-hidden="true">
				<span class="star" data-deco style="left: 8%; top: 30%" set:html={dot(COLORS.text)} />
				<span class="star" data-deco style="left: 27%; top: 50%" set:html={plus} />
				<span class="star" data-deco style="left: 49%; top: 20%" set:html={dot(COLORS.naples)} />
				<span class="star wide-only" data-deco style="left: 71%; top: 52%" set:html={dot(COLORS.text)} />
				<span class="star wide-only" data-deco style="left: 90%; top: 25%" set:html={plus} />
			</div>

			<section class="services" aria-labelledby="services">
				<div class="services-head">
					<h2 id="services" class="title">{serviceWord} services</h2>
					<p>Each one is a list you can sort, and {detailWord} open to more detail.</p>
				</div>
				<ServicePlate />
			</section>

			{/* Between the plate and the diagram: a night cloud, the moon and stars, in a row kept free of text. */}
			<div class="deco-row night-row" aria-hidden="true">
				<CellCloud class="night-cloud" shape="large" body={COLORS.methyl} shade={COLORS.text} cell={8} />
				<CellCloud class="night-cloud-small" shape="large" body={COLORS.methyl} shade={COLORS.text} cell={4} />
				<span class="moon" data-deco set:html={moon} />
				<span class="star" data-deco style="left: 52%; top: 22%" set:html={plus} />
				<span class="star" data-deco style="left: 63%; top: 70%" set:html={dot(COLORS.naples)} />
				<span class="star wide-only" data-deco style="left: 88%; top: 64%" set:html={dot(COLORS.text)} />
				<span class="star wide-only" data-deco style="left: 40%; top: 78%" set:html={dot(COLORS.text)} />
			</div>

			<section class="how" aria-labelledby="how">
				<div class="how-head stacked">
					<h2 id="how" class="title">How it works</h2>
					<p>nuvem stores no credentials of its own. gcloud issues a short-lived token for the configuration you chose, and nuvem keeps it in memory. Before anything changes, a confirmation shows what is about to run.</p>
				</div>
				<HowItWorks />
				<p class="read-more">Read more in <a href={docs.beforeChange}>Before a change runs</a>, the <a href={docs.credentials}>questions about credentials</a> and the <a href={`${REPO_BLOB_URL}/SECURITY.md`}>security policy</a>.</p>
			</section>

			<div class="deco-row close-row" aria-hidden="true">
				<CellCloud class="close-cloud" shape="wisp" body={COLORS.text} shade={COLORS.muted} cell={8} />
				<span class="star" data-deco style="left: 70%; top: 40%" set:html={dot(COLORS.naples)} />
				<span class="star wide-only" data-deco style="left: 86%; top: 15%" set:html={plus} />
			</div>

			{/* Stars in the page's side margins, only where the margins are wide. */}
			<div class="gutter-stars" aria-hidden="true">
				<span class="star left" data-deco style="top: 8%" set:html={plus} />
				<span class="star left far" data-deco style="top: 31%" set:html={dot(COLORS.naples)} />
				<span class="star left" data-deco style="top: 58%" set:html={dot(COLORS.text)} />
				<span class="star right" data-deco style="top: 18%" set:html={dot(COLORS.text)} />
				<span class="star right far" data-deco style="top: 44%" set:html={plus} />
				<span class="star right" data-deco style="top: 72%" set:html={dot(COLORS.naples)} />
			</div>

			<section class="closing" aria-labelledby="install">
				<div class="sky-edge close-edge" aria-hidden="true"></div>
				<div class="mark">
					<Wordmark ink="var(--nv-naples)" offset="var(--nv-coral)" />
					<p class="entry" lang="pt"><b>nuvem</b> <span class="ipa">/ˈnu.vẽj/</span> <span class="pos" lang="en">noun, Portuguese:</span> <span lang="en">cloud.</span></p>
				</div>
				<div class="get">
					<h2 id="install" class="title">Install</h2>
					<InstallCommand id="install-bottom" command={INSTALL} />
					<p>Every method, and what nuvem needs, is on the <a href={docs.install}>Install</a> page.</p>
					<p>Then run <code>nuvem --demo</code> to try it on sample data, with no account, or <code>nuvem</code> to open your active gcloud configuration.</p>
				</div>
			</section>
		</div>
	</div>
</StarlightPage>

<style is:global>
	/* The home page is wider than a docs page, and its sky runs to both edges
	   of the window. The panel clips what runs past them. */
	main:has(.nv-landing) .sl-container {
		position: relative;
		max-width: 76rem;
	}

	main:has(.nv-landing) .content-panel {
		overflow-x: clip;
		padding-top: var(--nv-space-4);
		padding-bottom: 0;
		background-color: var(--nv-methyl);
	}

	/* Below the footer the page is the footer's near-black. */
	:root:has(.nv-landing) body {
		background-color: var(--nv-ink);
	}

	/* Day: the header sits on the same blue as the hero, without the strip,
	   and everything in it is dark ink. */
	:root:has(.nv-landing) header.header {
		background-color: var(--nv-methyl);
		background-image: none;
	}

	/* The Naples wordmark, darkened to ink for the blue sky. */
	:root:has(.nv-landing) .site-title img {
		filter: brightness(0.107);
	}

	:root:has(.nv-landing) site-search button[data-open-modal],
	:root:has(.nv-landing) site-search button[data-open-modal]:hover {
		border-color: var(--nv-ink);
		background-color: transparent;
		color: var(--nv-ink);
	}

	:root:has(.nv-landing) site-search button[data-open-modal]::after {
		border-color: var(--nv-ink);
		color: var(--nv-ink);
	}

	:root:has(.nv-landing) .header .site-links a {
		color: var(--nv-ink);
	}

	:root:has(.nv-landing) .header .site-links .docs-link {
		font-weight: 650;
		text-decoration-thickness: 2px;
	}

	/* Rings on the blue header bar are ink. The search dialog opens inside
	   the header but on the brown, so its controls keep the Naples ring. */
	:root:has(.nv-landing) header.header :focus-visible:not(dialog :focus-visible) {
		outline: 3px solid var(--nv-ink);
	}

	/* The skip link appears over the blue header. */
	:root:has(.nv-landing) .sl-skip-link:focus-visible {
		outline: 3px solid var(--nv-ink);
	}

	/* The hero is Starlight's: the title, set left, in ink on the blue. */
	main:has(.nv-landing) .hero {
		position: relative;
		display: block;
		padding-block: clamp(0rem, 4vw - 1rem, 0.5rem) 0;
	}

	main:has(.nv-landing) .sl-container > .sl-markdown-content {
		margin-top: clamp(0.5rem, 1vw, 1rem);
	}

	@media (max-width: 40rem) {
		main:has(.nv-landing) .content-panel {
			padding-top: var(--nv-space-2);
		}
	}

	main:has(.nv-landing) .hero .stack {
		gap: 0;
		text-align: start;
	}

	main:has(.nv-landing) .hero .copy {
		align-items: start;
		gap: var(--nv-space-4);
	}

	main:has(.nv-landing) .hero .copy > * {
		max-width: none;
	}

	main:has(.nv-landing) .hero h1#_top {
		color: var(--nv-ink);
		font-size: var(--nv-text-hero);
		font-weight: 800;
		line-height: 0.98;
		letter-spacing: -0.035em;
		text-wrap: balance;
	}

	/* Day clouds: from 64rem the title stops 15rem short of the column's
	   edge, and the clouds live in that space, inside the title's own box,
	   so they can never reach text. The large one runs off the page. */
	@media (min-width: 64rem) {
		main:has(.nv-landing) .hero .copy > h1#_top {
			max-width: calc(100% - 15rem);
		}

		main:has(.nv-landing) .hero::after {
			content: '';
			position: absolute;
			top: 0;
			bottom: 0;
			right: calc(-1 * var(--sl-content-pad-x) - 4rem);
			width: calc(14rem + var(--sl-content-pad-x) + 4rem);
			background:
				var(--sky-day-large) right 0 bottom 0 / 228px 72px no-repeat,
				var(--sky-day-small) left 0 top 0 / 80px 28px no-repeat;
			pointer-events: none;
		}
	}

	.sl-markdown-content > .nv-landing.not-content {
		max-width: none;
	}

	/* The page ends on the closing; the colophon follows it, on near-black. */
	main:has(.nv-landing) footer.sl-flex {
		display: none;
	}

	main:has(.nv-landing) .colophon {
		margin-top: 0;
		padding-block: var(--nv-space-6) var(--nv-space-7);
		position: relative;
		isolation: isolate;
		background-image: none;
	}

	/* The footer's near-black, edge to edge, a little past its bottom so
	   no row of the blue panel shows under it. */
	main:has(.nv-landing) .colophon::before {
		content: '';
		position: absolute;
		top: 0;
		bottom: -2px;
		left: 50%;
		z-index: -1;
		width: 100vw;
		margin-left: -50vw;
		background-color: var(--nv-ink);
	}
</style>

<style>
	.nv-landing {
		color: var(--nv-text);
		font-size: var(--nv-text-body);
		line-height: var(--nv-leading-body);
	}

	.nv-landing a {
		color: var(--nv-coral);
		text-decoration-line: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.2em;
	}

	.nv-landing a:hover {
		text-decoration-thickness: 2px;
	}

	.nv-landing p {
		max-width: var(--nv-measure);
		margin: 0;
	}

	.nv-landing :not(pre) > code {
		padding: 0.1em 0.35em;
		border-radius: var(--nv-radius);
		background-color: var(--nv-plate-raised);
		color: var(--nv-text);
		font-family: var(--nv-font-mono);
		font-size: 0.875em;
		white-space: nowrap;
	}

	.title {
		margin: 0;
		color: inherit;
		font-size: var(--nv-text-section);
		font-weight: 800;
		line-height: 1;
		letter-spacing: -0.035em;
