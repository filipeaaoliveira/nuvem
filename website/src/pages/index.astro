---
// The home page. It is a Starlight page with the splash template, so it
// shares the docs' header, search (`/`), skip link and footer. The hero is
// Starlight's, restyled below; everything after it is this page's own.
//
// Every docs link goes through docHref(), which fails the build when the
// page or anchor it names does not exist.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import InstallCommand from '../components/landing/InstallCommand.astro';
import DemoRecording from '../components/landing/DemoRecording.astro';
import TerminalFrame from '../components/landing/TerminalFrame.astro';
import { demoPath } from '../lib/demo-assets.mjs';
import { docHref } from '../lib/doc-links.mjs';
import { REPO_BLOB_URL, buildSidebar, firstPageUrl } from '../lib/docs-source.mjs';

const INSTALL = 'brew install filipeaaoliveira/tap/nuvem';
const pageTitle = 'nuvem: a terminal UI for Google Cloud';
const description =
	'nuvem is a terminal UI for Google Cloud in the spirit of k9s. Browse and operate your projects from the keyboard, with the gcloud configurations you already have.';

const docs = {
	install: await docHref('getting-started/install.md'),
	release: await docHref('getting-started/install.md#download-a-release'),
	source: await docHref('getting-started/install.md#build-from-source'),
	firstRun: await docHref('getting-started/first-run.md'),
	credentials: await docHref('troubleshooting/faq.md#does-nuvem-store-my-credentials'),
	beforeChange: await docHref('reference/services/overview.md#before-a-change-runs'),
	keys: await docHref('reference/keys.md'),
	start: firstPageUrl(buildSidebar()),
};

/**
 * What someone deciding whether to install should know, each introduced by
 * the key or flag that reaches it and linked to its docs page. The docs
 * cover the rest.
 */
const capabilities = [
	{
		reach: [{ key: 'g' }],
		name: 'Services',
		href: 'reference/services/overview.md',
		text: 'Sixteen of them, from Compute Engine, GKE and Cloud SQL to Pub/Sub, BigQuery and IAM. Each is a list you can sort, and seven open to more detail.',
	},
	{
		reach: [{ key: '/' }],
		name: 'Filter a list',
		href: 'guides/filter-a-list.md',
		text: 'Narrow a list by regex, fuzzy match, label or inverse match.',
	},
	{
		reach: [{ key: ':' }],
		name: 'Command palette',
		href: 'guides/command-palette.md',
		text: 'Run a command by name instead of remembering its key.',
	},
	{
		reach: [{ key: 'Space' }, { word: 'then' }, { key: ':' }],
		name: 'Lifecycle actions',
		href: 'guides/batch-actions.md',
		text: 'Start, stop, reset, suspend or resume Compute Engine instances. Start, stop, restart or fail over Cloud SQL instances. Mark rows with Space to act on several at once. A confirmation shows the API call for each one first.',
	},
	{
		reach: [{ key: 'l' }],
		name: 'Cloud Logging',
		href: 'guides/cloud-logging.md',
		text: 'Read, tail and search the project’s logs. In most services, L opens the logs of the selected resource.',
	},
	{
		reach: [{ key: 't' }],
		name: 'Tunnels',
		href: 'guides/tunnels.md',
		text: 'Start IAP, SSH or Cloud SQL Auth Proxy port forwards from a Compute Engine or Cloud SQL row, and manage them from one list.',
	},
	{
		reach: [{ flag: '--read-only' }],
		name: 'Read-only mode',
		href: 'guides/read-only-mode.md',
		text: 'Refuses every change to a cloud resource, and the SSH and k9s sessions that could make one.',
	},
	{
		reach: [{ key: ',' }],
		name: 'Plugins',
		href: 'plugins/overview.md',
		text: 'Add your own gcloud commands to a service. They run against the selected row, after a confirmation that shows the whole command line.',
	},
];

for (const item of capabilities) item.href = await docHref(item.href);

/** Spoken before the key column, so a screen reader hears "Key: g", not "g". */
const reachLabel = (reach) => (reach[0].flag ? 'Flag:' : reach.filter((r) => r.key).length > 1 ? 'Keys:' : 'Key:');
---

<StarlightPage
	frontmatter={{
		title: 'nuvem',
		description,
		template: 'splash',
		pagefind: false,
		prev: false,
		next: false,
		hero: {
			title: 'A terminal UI for Google&nbsp;Cloud',
			tagline:
				'Browse and operate your Google Cloud projects from the keyboard, in the spirit of k9s. nuvem works with the gcloud configurations you already have, and shows you what it is about to do before it changes anything.',
		},
		head: [
			{ tag: 'title', content: pageTitle },
			{ tag: 'meta', attrs: { property: 'og:title', content: pageTitle } },
			{ tag: 'meta', attrs: { property: 'og:type', content: 'website' } },
			{ tag: 'meta', attrs: { name: 'theme-color', content: '#423b36' } },
			{ tag: 'meta', attrs: { name: 'color-scheme', content: 'dark' } },
		],
	}}
>
	<div class="nv-landing not-content">
		<section class="get-it">
			<InstallCommand id="install-top" command={INSTALL} />
			<p class="also">Homebrew on macOS and Linux. Or download a <a href={docs.release}>release binary</a>, or <a href={docs.source}>build from source</a>.</p>
			<p class="next">Try it first with <code>nuvem --demo</code>, on sample data with no account. Your own projects need the gcloud CLI, signed in. See <a href={docs.firstRun}>First run</a>.</p>
		</section>

		<DemoRecording
			description="A tour of nuvem --demo on its built-in sample data: Home, a resource list, a filter, a detail view, a Stop confirmation, BigQuery tables and help."
		/>

		<section aria-labelledby="what">
			<h2 id="what">What you can do with it</h2>
			<ul class="keyed">
				{
					capabilities.map((item) => (
						<li>
							<span class="head">
								<span class="reach">
									<span class="sr-only">{reachLabel(item.reach)} </span>
									{item.reach.map((r) =>
										r.key ? <kbd>{r.key}</kbd> : r.flag ? <code>{r.flag}</code> : <span class="word"> {r.word} </span>,
									)}
								</span>
								<a href={item.href}>{item.name}</a>
							</span>
							<span class="text">{item.text}</span>
						</li>
					))
				}
			</ul>
			<p class="rest">Configurations, FinOps, related-resource jumps and themes are in the <a href={docs.start}>documentation</a>, and the <a href={docs.keys}>Keys</a> page lists every key.</p>
			<TerminalFrame
				id="palette-frame"
				file={demoPath('frame')}
				focus="commands"
				description="nuvem's command palette open over a resource list, offering the commands for the selected row and the views it can open."
			>
				The command palette, as nuvem draws it. Open it with <kbd>:</kbd>.
			</TerminalFrame>
		</section>

		<div class="closing">
		<section aria-labelledby="how">
			<h2 id="how">How it works</h2>
			<p>nuvem reads Google Cloud through the official Google Cloud client libraries for Rust, with a short-lived access token that gcloud issues for the configuration you chose. A few reads, such as BigQuery, budgets and label filters, run the <code>bq</code> or <code>gcloud</code> command instead. The token stays in memory and is never written to disk, so nuvem stores no credentials of its own.</p>
			<p>Lifecycle actions on Compute Engine and Cloud SQL go through the same client libraries. SSH, tunnels to Compute Engine, plugins and changes to your gcloud configurations run the <code>gcloud</code> CLI you already have, and Cloud SQL tunnels run <code>cloud-sql-proxy</code>. Before anything changes, a confirmation shows what is about to happen. For a lifecycle action, it shows the API call. For SSH, tunnels, k9s, plugins and activating a configuration, it shows the command line. When you create or edit a configuration, it shows the values themselves.</p>
			<p>Read more in <a href={docs.beforeChange}>Before a change runs</a>, the <a href={docs.credentials}>questions about credentials</a> and the <a href={`${REPO_BLOB_URL}/SECURITY.md`}>security policy</a>.</p>
		</section>

		<section aria-labelledby="install">
			<h2 id="install">Install</h2>
			<InstallCommand id="install-bottom" command={INSTALL} />
			<p class="also">Every method, and what nuvem needs, is on the <a href={docs.install}>Install</a> page.</p>
		</section>
		</div>
	</div>
</StarlightPage>

<style is:global>
	/* The hero is Starlight's; here it is centred, with the install block under it. */
	main:has(.nv-landing) .hero {
		display: block;
		padding-block: 0;
	}

	/* Keep the hero, the install block and the recording close, so the
	   recording starts in the first viewport of a laptop screen. */
	main:has(.nv-landing) .sl-container > .sl-markdown-content {
		margin-top: var(--nv-space-5);
	}

	main:has(.nv-landing) .hero .stack {
		gap: 0;
		text-align: center;
	}

	main:has(.nv-landing) .hero .copy {
		align-items: center;
		gap: var(--nv-space-3);
	}

	main:has(.nv-landing) .hero .copy > * {
		max-width: none;
	}

	main:has(.nv-landing) .hero h1 {
		color: var(--nv-naples);
		font-size: var(--nv-text-display);
		font-weight: 700;
		line-height: 1.08;
		letter-spacing: -0.025em;
		text-wrap: balance;
	}

	main:has(.nv-landing) .hero .tagline {
		max-width: 58rem;
		color: var(--nv-text);
		font-size: var(--nv-text-lead);
		line-height: 1.55;
	}

	.sl-markdown-content > .nv-landing.not-content {
		max-width: none;
	}
</style>

<style>
	.nv-landing {
		color: var(--nv-text);
		font-size: var(--nv-text-body);
		line-height: var(--nv-leading-body);
	}

	.nv-landing a {
		color: var(--nv-coral);
		text-decoration-line: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.2em;
	}

	.nv-landing a:hover {
		text-decoration-thickness: 2px;
	}

	.nv-landing p {
		max-width: var(--nv-measure);
		margin: 0;
	}

	.nv-landing :not(pre) > code {
		padding: 0.1em 0.35em;
		border-radius: var(--nv-radius);
		background-color: var(--nv-plate-raised);
		color: var(--nv-text);
		font-family: var(--nv-font-mono);
		font-size: 0.875em;
		white-space: nowrap;
	}

	/* Install, alternatives and the first-run step, then the recording. */
	.get-it {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		justify-items: center;
		gap: var(--nv-space-2);
		margin-bottom: var(--nv-space-4);
		text-align: center;
	}

	.get-it > p {
		max-width: 60rem;
	}

	.get-it > p + p {
		margin-top: 0;
	}

	.also,
	.next {
		color: var(--nv-text-muted);
		font-size: var(--nv-text-body-sm);
	}

	.next {
		color: var(--nv-text);
	}

	section + section,
	.nv-landing > figure + section {
		margin-top: var(--nv-space-8);
	}

	h2 {
		margin: 0 0 var(--nv-space-5);
		padding-top: var(--nv-space-4);
		border-top: 1px solid var(--nv-rule);
		color: var(--nv-text);
		font-size: var(--nv-text-h2);
		font-weight: 650;
		line-height: var(--nv-leading-tight);
		letter-spacing: -0.01em;
	}

	/* How it works and the closing install, side by side on wide screens. */
	.closing {
		display: grid;
		gap: var(--nv-space-8) var(--nv-space-7);
		margin-top: var(--nv-space-8);
	}

	@media (min-width: 64rem) {
		.closing {
			grid-template-columns: 1fr 1fr;
		}
	}

	.closing > section {
		margin-top: 0;
	}

	.closing .also {
		margin-top: var(--nv-space-3);
	}

	section > p + p {
		margin-top: var(--nv-space-4);
	}

	/* What you can do: each capability is a row whose title line starts with
	   the key or flag that reaches it, on the same baseline as the link. */
	.keyed {
		display: grid;
		column-gap: var(--nv-space-7);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.keyed li {
		display: grid;
		align-content: start;
		gap: var(--nv-space-1);
		padding-block: var(--nv-space-3);
		border-bottom: 1px solid var(--nv-rule);
	}

	@media (min-width: 64rem) {
		.keyed {
			grid-template-columns: 1fr 1fr;
		}
	}

	.head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: var(--nv-space-1) var(--nv-space-3);
	}

	.head a {
		font-weight: 650;
	}

	.nv-landing .rest {
		margin-top: var(--nv-space-4);
		margin-bottom: var(--nv-space-6);
	}

	.reach {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.25em;
		color: var(--nv-text);
		font-family: var(--nv-font-mono);
		font-size: var(--nv-text-body-sm);
	}

	.reach .word {
		color: var(--nv-text-muted);
		font-family: var(--nv-font-sans);
		font-size: var(--nv-text-small);
	}

	.reach code {
		padding: 0;
		background: none;
		font-size: inherit;
		color: inherit;
	}

	kbd {
		display: inline-block;
		min-width: 1.75em;
		padding: 0 0.45em;
		border: 1px solid var(--nv-rule-strong);
		border-bottom-width: 2px;
		border-radius: var(--nv-radius);
		background-color: var(--nv-plate-raised);
		color: var(--nv-text);
		font-family: var(--nv-font-mono);
		font-size: var(--nv-text-body-sm);
		font-weight: 650;
		line-height: 1.5;
		text-align: center;
	}

	.text {
		color: var(--nv-text-muted);
		font-size: var(--nv-text-body-sm);
		line-height: 1.55;
	}
</style>
