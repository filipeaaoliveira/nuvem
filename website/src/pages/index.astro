---
// The home page. It is a Starlight page with the splash template, so it
// shares the docs' header, search (`/`), skip link and footer. The hero is
// Starlight's, restyled below; everything after it is this page's own.
//
// Every docs link goes through docHref(), which fails the build when the
// page or anchor it names does not exist.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import InstallCommand from '../components/landing/InstallCommand.astro';
import DemoRecording from '../components/landing/DemoRecording.astro';
import TerminalFrame from '../components/landing/TerminalFrame.astro';
import { demoPath } from '../lib/demo-assets.mjs';
import { docHref } from '../lib/doc-links.mjs';
import { REPO_BLOB_URL } from '../lib/docs-source.mjs';

const INSTALL = 'brew install filipeaaoliveira/tap/nuvem';
const pageTitle = 'nuvem: a terminal UI for Google Cloud';
const description =
	'nuvem is a terminal UI for Google Cloud in the spirit of k9s. Browse and operate your projects from the keyboard, with the gcloud configurations you already have.';

const docs = {
	install: await docHref('getting-started/install.md'),
	release: await docHref('getting-started/install.md#download-a-release'),
	source: await docHref('getting-started/install.md#build-from-source'),
	firstRun: await docHref('getting-started/first-run.md'),
	credentials: await docHref('troubleshooting/faq.md#does-nuvem-store-my-credentials'),
};

/**
 * What someone deciding whether to install should know, each introduced by
 * the key or flag that reaches it and linked to its docs page. The docs
 * cover the rest.
 */
const capabilities = [
	{
		reach: [{ key: 'g' }],
		name: 'Services',
		href: 'reference/services/overview.md',
		text: 'Compute Engine, GKE, Cloud Run, Cloud Functions, Cloud SQL, Cloud Storage, Secret Manager, persistent disks, Pub/Sub topics and subscriptions, BigQuery, VPC networks and subnets, firewall rules, service accounts and IAM policy. Each is a sortable list; Compute Engine, GKE, Cloud SQL, Cloud Run, Cloud Storage, Secret Manager and BigQuery also open to more detail.',
	},
	{
		reach: [{ key: '/' }],
		name: 'Filter a list',
		href: 'guides/filter-a-list.md',
		text: 'Narrow a list by regex, fuzzy match, label or inverse match.',
	},
	{
		reach: [{ key: ':' }],
		name: 'Command palette',
		href: 'guides/command-palette.md',
		text: 'Run a command by name instead of remembering its key.',
	},
	{
		reach: [{ key: 'Space' }, { word: 'then' }, { key: ':' }],
		name: 'Lifecycle actions',
		href: 'guides/batch-actions.md',
		text: 'Start, stop, reset, suspend or resume Compute Engine instances; start, stop, restart or fail over Cloud SQL. Mark rows with Space to act on several at once. A confirmation shows each gcloud command first.',
	},
	{
		reach: [{ key: 'l' }],
		name: 'Cloud Logging',
		href: 'guides/cloud-logging.md',
		text: 'Read, tail and search the project’s logs. L opens them for the selected resource.',
	},
	{
		reach: [{ key: 't' }],
		name: 'Tunnels',
		href: 'guides/tunnels.md',
		text: 'Start IAP, SSH or Cloud SQL Auth Proxy port forwards from a Compute Engine or Cloud SQL row, and manage them from one list.',
	},
	{
		reach: [{ flag: '--read-only' }],
		name: 'Read-only mode',
		href: 'guides/read-only-mode.md',
		text: 'Refuses every command that changes a cloud resource.',
	},
	{
		reach: [{ key: ',' }],
		name: 'Plugins',
		href: 'plugins/overview.md',
		text: 'Add your own gcloud commands to a service. They run against the selected row, behind the same confirmation.',
	},
];

for (const item of capabilities) item.href = await docHref(item.href);

/** Spoken before the key column, so a screen reader hears "Key: g", not "g". */
const reachLabel = (reach) => (reach[0].flag ? 'Flag:' : reach.filter((r) => r.key).length > 1 ? 'Keys:' : 'Key:');
---

<StarlightPage
	frontmatter={{
		title: 'nuvem',
		description,
		template: 'splash',
		pagefind: false,
		prev: false,
		next: false,
		hero: {
			title: 'A terminal UI for Google&nbsp;Cloud',
			tagline:
				'In the spirit of k9s: browse and operate your Google Cloud projects from the keyboard. nuvem works with the gcloud configurations you already have, and shows you the exact gcloud command before it changes anything.',
		},
		head: [
			{ tag: 'title', content: pageTitle },
			{ tag: 'meta', attrs: { property: 'og:title', content: pageTitle } },
			{ tag: 'meta', attrs: { property: 'og:type', content: 'website' } },
			{ tag: 'meta', attrs: { name: 'theme-color', content: '#423b36' } },
			{ tag: 'meta', attrs: { name: 'color-scheme', content: 'dark' } },
		],
	}}
>
	<div class="nv-landing not-content">
		<section class="get-it">
			<InstallCommand id="install-top" command={INSTALL} />
			<p class="also">Homebrew on macOS and Linux. Or download a <a href={docs.release}>release binary</a>, or <a href={docs.source}>build from source</a>.</p>
			<p class="next">Try it first with <code>nuvem --demo</code>: built-in sample data, no Google Cloud account. On your own projects nuvem needs the gcloud CLI, signed in; <a href={docs.firstRun}>First run</a> shows how.</p>
		</section>

		<DemoRecording
			description="A tour of nuvem --demo on its built-in sample data: Home, a resource list, a filter, a detail view, the command palette and help."
		/>

		<section aria-labelledby="what">
			<h2 id="what">What you can do with it</h2>
			<ul class="keyed">
				{
					capabilities.map((item) => (
						<li>
							<span class="reach">
								<span class="sr-only">{reachLabel(item.reach)} </span>
								{item.reach.map((r) =>
									r.key ? <kbd>{r.key}</kbd> : r.flag ? <code>{r.flag}</code> : <span class="word"> {r.word} </span>,
								)}
							</span>
							<span class="body">
								<a href={item.href}>{item.name}</a>
								<span class="text">{item.text}</span>
							</span>
						</li>
					))
				}
			</ul>
			<p class="rest">Configurations, FinOps, related-resource jumps, themes and every key are in the <a href="/docs/">documentation</a>.</p>
			<TerminalFrame
				id="palette-frame"
				file={demoPath('frame')}
				focus="commands"
				description="nuvem's command palette open over the GCE instances list. It offers commands for the selected instance: stop, reset, suspend, SSH, start a tunnel, copy its fields and open its logs."
			>
				The command palette, as nuvem draws it. Open it with <kbd>:</kbd>
			</TerminalFrame>
		</section>

		<section aria-labelledby="how">
			<h2 id="how">How it works</h2>
			<p>nuvem reads Google Cloud through the official Google Cloud client libraries for Rust, with a short-lived access token that gcloud issues for the configuration you chose. A few reads, such as BigQuery, budgets and label filters, run the <code>bq</code> or <code>gcloud</code> command instead. The token stays in memory and is never written to disk, so nuvem stores no credentials of its own.</p>
			<p>Everything that changes something, from starting an instance to running a plugin, goes through the <code>gcloud</code> CLI you already have, after a confirmation that shows the exact command.</p>
			<p>More in the <a href={docs.credentials}>questions about credentials</a> and the <a href={`${REPO_BLOB_URL}/SECURITY.md`}>security policy</a>.</p>
		</section>

		<section aria-labelledby="install">
			<h2 id="install">Install</h2>
			<InstallCommand id="install-bottom" command={INSTALL} />
			<p class="also">Every method, and what nuvem needs, is on the <a href={docs.install}>Install</a> page.</p>
		</section>
	</div>
</StarlightPage>

<style is:global>
	/* The hero is Starlight's; here it is centred, with the install block under it. */
	main:has(.nv-landing) .hero {
		display: block;
		padding-block: var(--nv-space-5) var(--nv-space-3);
	}

	main:has(.nv-landing) .hero .stack {
		gap: 0;
		text-align: center;
	}

	main:has(.nv-landing) .hero .copy {
		align-items: center;
		gap: var(--nv-space-3);
	}

	main:has(.nv-landing) .hero .copy > * {
		max-width: none;
	}

	main:has(.nv-landing) .hero h1 {
		color: var(--nv-naples);
		font-size: var(--nv-text-display);
		font-weight: 700;
		line-height: 1.08;
		letter-spacing: -0.025em;
		text-wrap: balance;
	}

	main:has(.nv-landing) .hero .tagline {
		max-width: 44rem;
		color: var(--nv-text);
		font-size: var(--nv-text-lead);
		line-height: 1.55;
	}

	.sl-markdown-content > .nv-landing.not-content {
		max-width: none;
	}
</style>

<style>
	.nv-landing {
		color: var(--nv-text);
		font-size: var(--nv-text-body);
		line-height: var(--nv-leading-body);
	}

	.nv-landing a {
		color: var(--nv-coral);
		text-decoration-line: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.2em;
	}

	.nv-landing a:hover {
		text-decoration-thickness: 2px;
	}

	.nv-landing p {
		max-width: var(--nv-measure);
		margin: 0;
	}

	.nv-landing :not(pre) > code {
		padding: 0.1em 0.35em;
		border-radius: var(--nv-radius);
		background-color: var(--nv-plate-raised);
		color: var(--nv-text);
		font-family: var(--nv-font-mono);
		font-size: 0.875em;
		white-space: nowrap;
	}

	/* Install, alternatives and the first-run step, then the recording. */
	.get-it {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		justify-items: center;
		gap: var(--nv-space-2);
		margin-bottom: var(--nv-space-4);
		text-align: center;
	}

	.also,
	.next {
		color: var(--nv-text-muted);
		font-size: var(--nv-text-body-sm);
	}

	.next {
		color: var(--nv-text);
	}

	section + section,
	.nv-landing > figure + section {
		margin-top: var(--nv-space-8);
	}

	h2 {
		margin: 0 0 var(--nv-space-5);
		padding-top: var(--nv-space-4);
		border-top: 1px solid var(--nv-rule);
		color: var(--nv-text);
		font-size: var(--nv-text-h2);
		font-weight: 650;
		line-height: var(--nv-leading-tight);
		letter-spacing: -0.01em;
	}

	section > p + p {
		margin-top: var(--nv-space-4);
	}

	/* What you can do: each capability, reached by its key or flag. The
	   key column is as wide as its widest entry, so longer flags or larger
	   text spacing widen it instead of overflowing. */
	.keyed {
		display: grid;
		grid-template-columns: max-content minmax(0, 1fr);
		column-gap: var(--nv-space-4);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.keyed li {
		display: grid;
		grid-column: 1 / -1;
		grid-template-columns: subgrid;
		padding-block: var(--nv-space-3);
		border-bottom: 1px solid var(--nv-rule);
	}

	@media (min-width: 64rem) {
		.keyed {
			grid-template-columns: max-content minmax(0, 1fr) var(--nv-space-5) max-content minmax(0, 1fr);
			column-gap: var(--nv-space-4);
		}

		.keyed li:nth-child(odd) {
			grid-column: 1 / span 2;
		}

		.keyed li:nth-child(even) {
			grid-column: 4 / span 2;
		}
	}

	.nv-landing .rest {
		margin-top: var(--nv-space-4);
		margin-bottom: var(--nv-space-6);
	}

	.reach {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.25em;
		color: var(--nv-text);
		font-family: var(--nv-font-mono);
		font-size: var(--nv-text-body-sm);
	}

	.reach .word {
		color: var(--nv-text-muted);
		font-family: var(--nv-font-sans);
		font-size: var(--nv-text-small);
	}

	.reach code {
		padding: 0;
		background: none;
		font-size: inherit;
		color: inherit;
	}

	kbd {
		display: inline-block;
		min-width: 1.75em;
		padding: 0 0.45em;
		border: 1px solid var(--nv-rule-strong);
		border-bottom-width: 2px;
		border-radius: var(--nv-radius);
		background-color: var(--nv-plate-raised);
		color: var(--nv-text);
		font-family: var(--nv-font-mono);
		font-size: var(--nv-text-body-sm);
		font-weight: 650;
		line-height: 1.5;
		text-align: center;
	}

	.body {
		display: grid;
		align-content: start;
		gap: var(--nv-space-1);
	}

	.body a {
		justify-self: start;
		font-weight: 650;
	}

	.text {
		color: var(--nv-text-muted);
		font-size: var(--nv-text-body-sm);
		line-height: 1.55;
	}

	@media (max-width: 30rem) {
		.keyed {
			display: block;
		}

		.keyed li {
			display: grid;
			gap: var(--nv-space-2);
		}
	}
</style>
