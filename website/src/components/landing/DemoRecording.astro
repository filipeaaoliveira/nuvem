---
// The recording of `nuvem --demo`, in a terminal plate with a Pause/Play
// control. The files come from demo/out/ (see src/lib/demo-assets.mjs).
//
// - Nothing loads before the page does: the video has preload="none" and
//   starts only after the load event, once it is on screen.
// - It is muted and loops. It pauses while scrolled out of view.
// - It starts by itself only on screens wider than 48rem, without
//   prefers-reduced-motion and without the browser's data saver. Otherwise
//   the poster shows, the control reads Play, and nothing is downloaded until
//   the reader presses it.
// - Up to 40rem, a 138-column screen would shrink past reading, so until
//   the reader presses Play the window shows a still instead: the Inventory
//   box of the Home screen as text (demo/frames/home.html), at a readable
//   size. Play swaps in the recording.
// - The poster is set by the script, and only where it shows: on a phone
//   it is not downloaded until Play.
// - Without JavaScript the window shows a still at every width, the
//   Inventory box on a phone and the whole Home screen as text above
//   40rem, and the caption links to the file to watch it full size.
import { getImage } from 'astro:assets';
import webm from '../../../../demo/out/nuvem-demo.webm?url';
import mp4 from '../../../../demo/out/nuvem-demo.mp4?url';
import posterSource from '../../../../demo/out/nuvem-demo-poster.png';
import { cropToBox, readTerminalFrame } from '../../lib/terminal-frame.mjs';
import { demoPath } from '../../lib/demo-assets.mjs';

interface Props {
	/** What the recording shows, for readers who cannot see it. */
	description: string;
}

const { description } = Astro.props;
const poster = await getImage({ src: posterSource, format: 'webp', quality: 85 });
// The service names and their counts, ending at the "loaded" column, so no
// status list is cut halfway and the text can be larger.
const home = readTerminalFrame(demoPath('frame-home'));
const still = cropToBox(home, 'Inventory', 33);
---

<figure class="recording" data-recording>
	<div class="bar">
		<span class="dots" aria-hidden="true"><span></span><span></span><span></span></span>
		<span class="caption"><span class="prompt" aria-hidden="true">$ </span>nuvem --demo</span>
		<button type="button" class="toggle" data-state="paused" aria-controls="recording-video" hidden>
			<svg class="icon-play" aria-hidden="true" width="12" height="12" viewBox="0 0 12 12">
				<path d="M2.5 1.2v9.6L10.5 6z" fill="currentColor"></path>
			</svg>
			<svg class="icon-pause" aria-hidden="true" width="12" height="12" viewBox="0 0 12 12">
				<path d="M2 1h3v10H2zM7 1h3v10H7z" fill="currentColor"></path>
			</svg>
			<span data-label>Play</span><span class="sr-only"> the recording</span>
		</button>
	</div>
	<video
		id="recording-video"
		width={posterSource.width}
		height={posterSource.height}
		style={`aspect-ratio: ${posterSource.width} / ${posterSource.height}`}
		data-poster={poster.src}
		preload="none"
		muted
		loop
		playsinline
		controls
		aria-describedby="recording-description"
	>
		<source src={webm} type="video/webm" />
		<source src={mp4} type="video/mp4" />
	</video>
	<div class="still" style={`--frame-bg: ${still.background}; --still-columns: ${still.columns}`}>
		<pre role="img" aria-label="nuvem's Home view: the number of loaded resources for each of its services." style={`color: ${still.color}`} set:html={still.html} />
	</div>
	<div class="still still-wide" style={`--frame-bg: ${home.background}; --still-columns: ${home.columns}`}>
		<pre role="img" aria-label="nuvem's Home view: the active configuration, account, region and project, then a count of loaded resources for each service." style={`color: ${home.color}`} set:html={home.html} />
	</div>
	<noscript>
		<style>
			[data-recording] video {
				display: none !important;
			}
			[data-recording] .still:not(.still-wide) {
				display: block !important;
			}
			@media (min-width: 40.0625rem) {
				[data-recording] .still:not(.still-wide) {
					display: none !important;
				}
				[data-recording] .still-wide {
					display: block !important;
				}
			}
		</style>
	</noscript>
	<figcaption><span id="recording-description">{description}</span> <a href={mp4}>Open it full size</a>.</figcaption>
</figure>

<script>
	const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
	const narrow = matchMedia('(max-width: 48rem)');
	// Up to here the window shows the still instead of the video (see the CSS).
	const stillOnly = matchMedia('(max-width: 40rem)');
	const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;
	const mayStartItself = () => !reducedMotion.matches && !narrow.matches && !saveData;

	for (const figure of document.querySelectorAll<HTMLElement>('[data-recording]')) {
		const video = figure.querySelector('video');
		const button = figure.querySelector<HTMLButtonElement>('button.toggle');
		const label = button?.querySelector<HTMLElement>('[data-label]');
		if (!video || !button || !label) continue;

		let onScreen = false;
		// What the reader asked for with the button: play, pause, or nothing yet.
		let wanted: 'play' | 'pause' | null = null;

		const show = () => {
			const playing = !video.paused;
			button.dataset.state = playing ? 'playing' : 'paused';
			label.textContent = playing ? 'Pause' : 'Play';
		};

		const update = () => {
			const play = onScreen && (wanted === 'play' || (wanted === null && mayStartItself()));
			if (play) video.play().catch(show);
			else video.pause();
		};

		// The poster, fetched only once the video can be seen.
		const showPoster = () => {
			if (!video.poster && video.dataset.poster && (!stillOnly.matches || figure.hasAttribute('data-started'))) video.poster = video.dataset.poster;
		};
		showPoster();
		stillOnly.addEventListener('change', showPoster);

		video.addEventListener('play', show);
		video.addEventListener('pause', show);
		button.addEventListener('click', () => {
			wanted = video.paused ? 'play' : 'pause';
			// On a narrow screen this replaces the still with the recording.
			if (wanted === 'play') {
				figure.toggleAttribute('data-started', true);
				showPoster();
			}
			if (wanted === 'play') video.play().catch(show);
			else video.pause();
		});
		reducedMotion.addEventListener('change', update);
		narrow.addEventListener('change', update);

		video.controls = false;
		button.hidden = false;
		show();

		const start = () =>
			new IntersectionObserver(
				([entry]) => {
					onScreen = entry.isIntersecting;
					update();
				},
				{ threshold: 0.25 },
			).observe(video);
		if (document.readyState === 'complete') start();
		else window.addEventListener('load', start, { once: true });
	}
</script>

<style>
	/* A terminal window with presence: an ink frame, a title bar, and a flat
	   Naples block offset behind it, like a second printing plate that has
	   slipped out of register. */
	.recording {
		position: relative;
		margin: 0;
		border: 3px solid var(--nv-ink);
		border-radius: var(--nv-radius);
		background-color: var(--nv-plate);
		box-shadow: clamp(0.5rem, 1.2vw, 1rem) clamp(0.5rem, 1.2vw, 1rem) 0 var(--nv-naples);
	}

	.bar {
		display: flex;
		align-items: center;
		gap: var(--nv-space-4);
		min-height: 2.75rem;
		padding: var(--nv-space-1) var(--nv-space-2) var(--nv-space-1) var(--nv-space-4);
		border-bottom: 3px solid var(--nv-ink);
		background-color: var(--nv-plate-raised);
	}

	/* The window's controls as three cells in the combination's colors. */
	.dots {
		display: flex;
		gap: 4px;
	}

	.dots span {
		width: 0.625rem;
		height: 0.625rem;
		background-color: var(--nv-coral);
	}

	.dots span:nth-child(2) {
		background-color: var(--nv-naples);
	}

	.dots span:nth-child(3) {
		background-color: var(--nv-methyl);
	}

	.caption {
		margin-inline-end: auto;
		color: var(--nv-text-muted);
		font-family: var(--nv-font-mono);
		font-size: var(--nv-text-small);
	}

	.prompt {
		color: var(--nv-naples);
	}

	.toggle {
		display: inline-flex;
		align-items: center;
		gap: var(--nv-space-2);
		min-height: 2rem;
		padding: 0 var(--nv-space-3);
		border: 1px solid var(--nv-rule-strong);
		border-radius: var(--nv-radius);
		background-color: var(--nv-plate);
		color: var(--nv-coral);
		font: inherit;
		font-size: var(--nv-text-small);
		font-weight: 650;
		cursor: pointer;
	}

	.toggle:hover {
		border-color: var(--nv-coral);
	}

	.toggle[hidden] {
		display: none;
	}

	.toggle[data-state='playing'] .icon-play,
	.toggle[data-state='paused'] .icon-pause {
		display: none;
	}

	video {
		display: block;
		width: 100%;
		height: auto;
		background-color: var(--nv-plate);
	}

	.recording {
		container-type: inline-size;
	}

	.still {
		display: none;
		overflow-x: auto;
		background-color: var(--frame-bg);
	}

	.still pre {
		width: max-content;
		margin: 0;
		padding: var(--nv-space-3);
		border: 0;
		background: none;
		font-family: var(--nv-font-mono);
		font-size: min(0.9375rem, max(0.625rem, (100cqi - 1.5rem - 6px) / (var(--still-columns) * 0.602)));
		line-height: 1.2;
		font-variant-ligatures: none;
		white-space: pre;
	}

	/* The whole screen, for readers without JavaScript above 40rem. */
	.still-wide pre {
		font-size: max(0.6875rem, (100cqi - 1.5rem - 6px) / (var(--still-columns) * 0.602));
	}

	/* Narrow: the still until Play, then the recording. */
	@media (max-width: 40rem) {
		.recording:not([data-started]) video {
			display: none;
		}

		.recording:not([data-started]) .still:not(.still-wide) {
			display: block;
		}
	}

	figcaption {
		padding: var(--nv-space-3) var(--nv-space-4);
		border-top: 3px solid var(--nv-ink);
		background-color: var(--nv-plate-raised);
		color: var(--nv-text-muted);
		font-size: var(--nv-text-small);
	}

	figcaption a {
		color: var(--nv-coral);
		text-decoration-line: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.2em;
	}

	figcaption a:hover {
		text-decoration-thickness: 2px;
	}
</style>
