---
// One screen of nuvem as text, read from demo/frames/ at build time (see
// src/lib/terminal-frame.mjs). The frame scales to fill the plate. Below
// 48rem the plate shows only the box the frame is about (`focus`), so the
// subject stays readable on a phone. If the text still does not fit, it
// scrolls sideways inside the plate, and only then takes keyboard focus.
import { cropToBox, readTerminalFrame } from '../../lib/terminal-frame.mjs';

interface Props {
	/** Absolute path of the frame file. */
	file: string;
	/** Title of the box to show on narrow screens, as drawn in the frame. */
	focus: string;
	/** What the screen shows, for readers who cannot see it. */
	description: string;
	/** Unique on the page. */
	id: string;
}

const { file, focus, description, id } = Astro.props;
const wide = readTerminalFrame(file);
// Wide enough for the palette's longest command names.
const narrow = cropToBox(wide, focus, 46);
const views = [
	{ frame: wide, class: 'wide' },
	{ frame: narrow, class: 'narrow' },
];
---

<figure class="frame">
	<div class="bar"><span id={`${id}-caption`}><slot /></span></div>
	{
		views.map(({ frame, class: view }) => (
			<div
				class:list={['scroll', view]}
				style={`--frame-bg: ${frame.background}`}
				role="region"
				aria-labelledby={`${id}-caption`}
				data-frame-scroll
			>
				<pre role="img" aria-label={description} style={`--columns: ${frame.columns}; color: ${frame.color}`} set:html={frame.html} />
			</div>
		))
	}
</figure>

<script>
	// A frame that scrolls sideways must be reachable by keyboard; one that
	// fits must not add an empty tab stop.
	const regions = document.querySelectorAll<HTMLElement>('[data-frame-scroll]');
	const update = () => {
		for (const region of regions) {
			if (region.scrollWidth > region.clientWidth + 1) region.tabIndex = 0;
			else region.removeAttribute('tabindex');
		}
	};
	const observer = new ResizeObserver(update);
	for (const region of regions) observer.observe(region);
</script>

<style>
	.frame {
		margin: 0;
		border: 1px solid var(--nv-rule);
		border-radius: var(--nv-radius);
		background-color: var(--nv-plate);
	}

	.bar {
		display: flex;
		align-items: center;
		min-height: 2.75rem;
		padding: var(--nv-space-1) var(--nv-space-4);
		border-bottom: 1px solid var(--nv-rule);
		color: var(--nv-text-muted);
		font-size: var(--nv-text-small);
	}

	.bar :global(kbd) {
		display: inline-block;
		min-width: 1.75em;
		padding: 0 0.45em;
		border: 1px solid var(--nv-rule-strong);
		border-bottom-width: 2px;
		border-radius: var(--nv-radius);
		background-color: var(--nv-plate-raised);
		color: var(--nv-text);
		font-family: var(--nv-font-mono);
		font-weight: 650;
		line-height: 1.5;
		text-align: center;
	}

	.scroll {
		--pad: var(--nv-space-4);
		container-type: inline-size;
		overflow-x: auto;
		/* Methyl edges show which side has more to see, as on code plates. */
		--nv-cue: color-mix(in srgb, var(--nv-methyl) 70%, transparent);
		background:
			linear-gradient(to right, var(--frame-bg), var(--frame-bg)) left / 1.25rem 100% no-repeat local,
			linear-gradient(to left, var(--frame-bg), var(--frame-bg)) right / 1.25rem 100% no-repeat local,
			linear-gradient(to right, var(--nv-cue), transparent) left / 0.5rem 100% no-repeat scroll,
			linear-gradient(to left, var(--nv-cue), transparent) right / 0.5rem 100% no-repeat scroll,
			var(--frame-bg);
	}

	.scroll:focus-visible {
		outline-offset: -2px;
	}

	.narrow {
		display: none;
	}

	@media (max-width: 48rem) {
		.wide {
			display: none;
		}

		.narrow {
			display: block;
		}
	}

	pre {
		width: max-content;
		margin: 0;
		padding: var(--pad);
		border: 0;
		border-radius: 0;
		background: none;
		font-family: var(--nv-font-mono);
		/* Fit the widest line to the plate (a monospace cell is about 0.61em),
		   but never below 11px. */
		font-size: max(0.6875rem, (100cqi - 2 * var(--pad)) / (var(--columns) * 0.61));
		line-height: 1.2;
		font-variant-ligatures: none;
		white-space: pre;
	}

	/* The narrow view fits a 360px screen at 10px or more, and is never
	   larger than body text. */
	.narrow {
		--pad: var(--nv-space-3);
	}

	.narrow pre {
		font-size: min(0.9375rem, max(0.625rem, (100cqi - 2 * var(--pad)) / (var(--columns) * 0.61)));
	}
</style>
