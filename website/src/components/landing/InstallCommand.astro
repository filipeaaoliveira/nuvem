---
// A shell command on a plate, with a Copy button on the same line. The `$`
// prompt is drawn by CSS, so selecting the text gives the command alone.
// When the command is wider than the plate (on a phone), it wraps after a
// `/` or at a space, so the whole command stays visible; the prompt hangs
// and the button stays beside the wrapped block. The button is in place
// from the first paint, so the command never rewraps when the script runs;
// without JavaScript a <noscript> style hides it and the command is plain
// selectable text.
interface Props {
	command: string;
	/** Unique on the page: the button finds its command by this id. */
	id: string;
}

const { command, id } = Astro.props;
// A break opportunity after every `/`; <wbr> adds no text, so copying and
// selecting still give the command exactly.
const parts = command.split('/');
---

<div class="install">
	<pre class="command"><code id={id}>{parts.map((part, i) => (i < parts.length - 1 ? <>{part}/<wbr /></> : part))}</code></pre>
	<button type="button" class="copy" data-copy={id}>
		<svg aria-hidden="true" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
			<rect x="5.5" y="5.5" width="8" height="8" rx="1"></rect>
			<path d="M10.5 3.5v-1a1 1 0 0 0-1-1h-6a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h1"></path>
		</svg>
		<span data-copy-label>Copy</span><span class="sr-only"> the command</span>
	</button>
	<span class="sr-only" role="status" data-copy-status={id}></span>
</div>

<noscript>
	<style>
		button[data-copy] {
			display: none !important;
		}
	</style>
</noscript>

<script>
	const RESET_AFTER_MS = 2000;

	for (const button of document.querySelectorAll<HTMLButtonElement>('button[data-copy]')) {
		const id = button.dataset.copy!;
		const code = document.getElementById(id);
		const label = button.querySelector<HTMLElement>('[data-copy-label]');
		const status = document.querySelector<HTMLElement>(`[data-copy-status="${id}"]`);
		if (!code || !label || !status) continue;
		let timer: number | undefined;

		const say = (text: string, copied: boolean) => {
			// Clear first so the same message is announced again on a second press.
			status.textContent = '';
			requestAnimationFrame(() => (status.textContent = text));
			label.textContent = copied ? 'Copied' : 'Copy';
			button.toggleAttribute('data-copied', copied);
			window.clearTimeout(timer);
			timer = window.setTimeout(() => {
				label.textContent = 'Copy';
				button.removeAttribute('data-copied');
			}, RESET_AFTER_MS);
		};

		button.addEventListener('click', async () => {
			const text = code.textContent ?? '';
			try {
				await navigator.clipboard.writeText(text);
				say('Command copied to the clipboard.', true);
			} catch {
				// No clipboard access (an insecure context, or permission denied):
				// select the command so the reader can copy it by hand.
				const range = document.createRange();
				range.selectNodeContents(code);
				const selection = window.getSelection();
				selection?.removeAllRanges();
				selection?.addRange(range);
				say('Could not copy. The command is selected: press Ctrl-C or Cmd-C to copy it.', false);
			}
		});
		button.hidden = false;
	}
</script>

<style>
	.install {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--nv-space-2);
		width: 100%;
		max-width: 40rem;
		padding: 0.375rem;
		border: 1px solid var(--nv-rule);
		border-radius: var(--nv-radius);
		background-color: var(--nv-plate);
		text-align: start;
	}

	.command {
		/* Takes almost all free space, so the button grows only when it is
		   alone on its own line. */
		flex: 1000 1 12rem;
		min-width: 0;
		margin: 0;
		/* The prompt hangs: a wrapped command continues under the command. */
		padding: var(--nv-space-2) var(--nv-space-2) var(--nv-space-2) calc(var(--nv-space-2) + 2ch);
		text-indent: -2ch;
		border: 0;
		background: none;
		color: var(--nv-text);
		font-family: var(--nv-font-mono);
		font-size: var(--nv-text-command);
		line-height: 1.6;
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}

	.command code {
		padding: 0;
		background: none;
		font: inherit;
		color: inherit;
	}

	.command::before {
		content: '$ ';
		color: var(--nv-naples);
		user-select: none;
		-webkit-user-select: none;
	}

	/* If the plate is too narrow for the button beside the wrapped command,
	   the button drops under it at full width. */
	.copy {
		flex: 1 0 auto;
		justify-content: center;
		max-width: 100%;
		display: inline-flex;
		align-items: center;
		gap: var(--nv-space-2);
		min-width: 2.75rem;
		min-height: 2.75rem;
		padding: 0 var(--nv-space-3);
		border: 1px solid var(--nv-rule-strong);
		border-radius: var(--nv-radius);
		background-color: var(--nv-plate);
		color: var(--nv-coral);
		font: inherit;
		font-size: var(--nv-text-small);
		font-weight: 650;
		cursor: pointer;
	}

	.copy:hover {
		border-color: var(--nv-coral);
	}

	/* The ring sits inside the button, on the plate, so it keeps its
	   contrast whatever the plate's own edge is next to. */
	.copy:focus-visible {
		outline: 2px solid var(--nv-naples);
		outline-offset: -5px;
	}

	.copy[data-copied] {
		color: var(--nv-naples);
	}

	.copy[hidden] {
		display: none;
	}
</style>
